！"]},{"code":101,"indent":0,"parameters":["學A學B",4,0,2,"學姊B"]},{"code":401,"indent":0,"parameters":["好好好謝謝你(感激涕零)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["阿蘇看著馬同學貼文裡的高級蛋糕、漂亮禮服、堆成小山的生日禮物"]},{"code":401,"indent":0,"parameters":["還有很多祝福的留言"]},{"code":101,"indent":0,"parameters":["asu大頭",0,0,2,"紫蘇"]},{"code":401,"indent":0,"parameters":["（哇，看起來很好玩，而且好高級）"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["阿蘇腦中閃過自己樸素的限動畫面"]},{"code":101,"indent":0,"parameters":["asu大頭",0,0,2,"紫蘇"]},{"code":401,"indent":0,"parameters":["（...不愧是小馬呢）"]},{"code":101,"indent":0,"parameters":["朋A朋B",0,0,2,"朋友A"]},{"code":401,"indent":0,"parameters":["啊！阿蘇也是前天生日！！"]},{"code":101,"indent":0,"parameters":["學A學B",0,0,2,"學姊A"]},{"code":401,"indent":0,"parameters":["哦對耶，不覺得同天生日很浪漫嗎"]},{"code":101,"indent":0,"parameters":["學A學B",4,0,2,"學姊B"]},{"code":401,"indent":0,"parameters":["我記得阿蘇限動的配樂很可愛~~"]},{"code":101,"indent":0,"parameters":["學C小馬",0,0,2,"學姊C"]},{"code":401,"indent":0,"parameters":["那我們可以買兩個蛋糕嗎，另一個選黑森林的！"]},{"code":101,"indent":0,"parameters":["學A學B",0,0,2,"學姊A"]},{"code":401,"indent":0,"parameters":["讓壽星選！！"]},{"code":101,"indent":0,"parameters":["學A學B",4,0,2,"學姊B"]},{"code":401,"indent":0,"parameters":["好啦走吧走吧，我們先去拍照"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["大家吃飽飯就一起去買蛋糕"]},{"code":235,"indent":0,"parameters":[58]},{"code":201,"indent":0,"parameters":[0,5,12,7,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":7,"y":8},
